#!/usr/bin/env bash

projectName='wardn'
projectDescription='Encrypted Bitwarden vault backups. Built with rayvn and valt.'
projectVersion='0.1.1+'
projectReleaseDate=''
docsWorktree='../wardn-pages'

# Brew formula metadata (used by rayvn/dependencies for formula generation and runtime dep checks)
# gnugrep, coreutils, gnutar and xz are listed in flake.nix because Nix wrappers use a minimal PATH; macOS and Linux
# already provide them (macOS tar handles .xz itself), so they are not brew dependencies or checked for.
declare -A nixBrewMap=([gnused]='gnu-sed')
declare -a nixBrewExclude=(curl gnugrep coreutils gnutar xz)
declare -A nixBinaryMap=([bitwarden-cli]='bw' [gnused]='gsed')
# Note: rayvnPkg → phoggy/rayvn/rayvn, valtPkg → phoggy/rayvn/valt (by convention)
