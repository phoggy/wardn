#!/usr/bin/env bash

projectName='wardn'
projectDescription='Encrypted Bitwarden vault backups. Built with rayvn and valt.'
projectVersion='0.2.0'
projectReleaseDate='2026-11-08 16:23:56 PST'
docsWorktree='../wardn-pages'

# Brew formula metadata (used by rayvn/dependencies for formula generation and runtime dep checks)
# gnugrep, coreutils, gnutar, xz and unzip are listed in flake.nix because Nix wrappers use a minimal PATH; macOS and
# Linux already provide them (macOS tar handles .xz itself), so they are not brew dependencies or checked for.
declare -A nixBrewMap=([gnused]='gnu-sed')
declare -a nixBrewExclude=(curl gnugrep coreutils gnutar xz unzip)
declare -A nixBinaryMap=([bitwarden-cli]='bw' [gnused]='gsed')
# Note: rayvnPkg → rayvn-central/brew/rayvn, valtPkg → rayvn-central/brew/valt (the tap releases publish to)
