#!/usr/bin/env rayvn-bash
# shellcheck disable=SC2155

# TODO: what to do about account recovery code?

# shellcheck disable=SC2120
usage() {
    echo
    show bold "Create a backup of a Bitwarden vault or restore a vault from one, as a" cyan "valt" bold "secure archive."
    echo
    show "Usage:" bold blue "${scriptName}" "[backup] [-i IDENTITY] [-r RECIPIENT]... [-R PATH]... [--no-self] [-b BACKUP_DIR] [-z ZONE]"
    show "      " bold blue "${scriptName}" "restore BACKUP_FILE [-i IDENTITY]"
    echo
    echo "The Bitwarden CLI is used to access the vault. Login/unlock requires user input: credentials are never stored."
    echo "Using an API key simplifies login, requiring only master password input rather than full credentials. This is"
    echo "enabled by setting the BW_CLIENTID and BW_CLIENTSECRET environment variables, for details see"
    show blue "https://bitwarden.com/help/personal-api-key/" glue "."
    echo
    show "Backups are valt secure archives (see" blue "${valtProjectUrl}" glue "): encrypted with" cyan "age" "and signed with your valt"
    show "key, so that tampering is detected on restore. Your own public key (the .pub file next to the identity) is always a"
    show "recipient unless --no-self is given; create a valt key pair with" blue "valt keys" glue ". A public companion"
    echo "(BACKUP_FILE.pub) that is safe to share is also created. Backups made by earlier versions of wardn (age encrypted"
    echo "tar files) can still be restored, with any age identity."
    echo
    show bold green "Note" "Both operations store" italic "unencrypted" "vault data temporarily. It is kept in memory (RAM backed storage)"
    show "rather than on disk, so that it cannot be recovered after it is deleted: storage set up by" blue "rayvn-tmp" glue ", /dev/shm on"
    echo "Linux, or else a RAM disk created for the purpose on macOS. If none is available you will be asked whether to"
    echo "continue using disk storage, from which deleted files may still be recoverable."
    echo
    echo "Options:"
    echo
    echo "    -i, --identity PATH          Your valt private key file, used to sign backups and to restore them (default:"
    show "                                 valt's default key, see 'valt default-key':" blue "${ tildePath "${defaultIdentityFile}"; }" glue ")."
    echo "    -r, --recipient RECIPIENT    Also encrypt to the specified RECIPIENT (age public key). May be repeated."
    echo "    -R, --recipients-file PATH   Also encrypt to the recipients listed at PATH, e.g. a valt .pub file. May be repeated."
    echo "    --no-self                    Do not include your own public key as a recipient."
    echo "    -b, --backup-dir PATH        Use the secure directory at PATH to store the encrypted backup."
    echo "    -p, --prefix PREFIX          Set a prefix for the backup file name."
    echo "    -z, --zone ZONE              The time zone for the timestamp in the backup file name: 'local', 'UTC' or a name"
    echo "                                 such as 'America/Los_Angeles' (default: local, the system time zone)."
    show "    -u, --url URL                Set the URL for the Bitwarden server (default:" blue "${defaultServerUrl}" glue ")"
    echo "    -l, --login                  Force full login even if API key environment variables are set."
    showCommonOptions 33 true true envVars
    bye "${@}"
}

main() {
    init "${@}"
    prepareVault
    if [[ -n ${restoreFile} ]]; then
        restoreVault
    else
        backupVault
    fi
}

init() {
    declare -gr defaultIdentityFile="${ defaultValtKeyFile; }"
    declare -gr defaultServerUrl='https://vault.bitwarden.com'
    declare -gr vaultFileName='vault.json'
    declare -gr importVaultFileName='import-vault.json'
    declare -gr attachmentsDirName='attachments'
    declare -gr restoreNoteName='🔥 Restored Vault'
    declare -gr doneCheck=". ${successCheckMark}"
    declare -gAr envVars=(
        ['BW_CLIENTID']="Bitwarden API key."
        ['BW_CLIENTSECRET']="Bitwarden API key secret."
        ['WARDN_BACKUP_DIR']="Default backup destination directory."
        ['WARDN_BACKUP_PREFIX']="Default backup file name prefix."
    )

    namePrefix="${WARDN_BACKUP_PREFIX}"
    timeZone='local'
    vaultUrl=
    restoreFile=

    [[ -n ${WARDN_SECURE_TEMP_DIR:-} ]] && warn "WARDN_SECURE_TEMP_DIR is no longer used: RAM backed storage is used for" \
        "the unencrypted vault data whenever possible."

    # WARDN_RECIPIENT and WARDN_IDENTITY were replaced by your valt key always being a recipient, and valt's default
    # key: say so rather than silently ignore them

    [[ -n ${WARDN_RECIPIENT:-} ]] && warn "WARDN_RECIPIENT is no longer used: your valt key is always a recipient;" \
        "use -r or -R for others."
    [[ -n ${WARDN_IDENTITY:-} ]] && warn "WARDN_IDENTITY is no longer used: use 'valt default-key' to set the default" \
        "key, or -i."

    recipients=()
    identityFile="${defaultIdentityFile}"
    noSelf=0

    while (( $# > 0 )); do
        case "${1}" in
            backup) unset restoreFile ;;
            restore) shift; setFileVar restoreFile "${1}" ;;
            -r | --recipient) shift; recipients+=('-r' "${1}") ;;
            -R | --recipients-file) shift; assertFile "${1}" "recipients file"; recipients+=('-R' "${1}") ;;
            -i | --identity | --identity-file) shift; identityFile="${1}" ;;
            --no-self) noSelf=1 ;;
            -b | --backup-dir) shift; setDirVar backupDir "${1}" "backup dir path" ;;
            -p | --prefix) shift; namePrefix="${1}" ;;
            -z | --zone) shift; timeZone="${1}"; timeStamp "${timeZone}" > /dev/null ;;
            -u | --url) shift; vaultUrl="${1}" ;;
            -l | --login) unset BW_CLIENTID BW_CLIENTSECRET BW_SESSION WARDN_DEV_BW_PWD ;;
            --update) updateCLI; exit 0 ;;
            --debug*) setDebug "$@"; shift $? ;;
            -h | --help) usage ;;
            -v) projectVersion wardn; exit 0 ;;
            --version) projectVersion wardn true; exit 0 ;;
            *) usage "Unknown argument: ${1}" ;;
        esac
        shift
    done

    if [[ -z ${backupDir} ]]; then
        if [[ -n ${WARDN_BACKUP_DIR} ]]; then
             setDirVar backupDir "${WARDN_BACKUP_DIR}"
        else
            usage "Secure backup directory not specified."
        fi
    fi

    [[ -n ${vaultUrl} ]] || vaultUrl="${defaultServerUrl}"

    [[ -f ${identityFile} ]] || usage "identity file not found: ${ tildePath "${identityFile}"; } (create one with 'valt keys')"

    if [[ -z ${restoreFile} ]]; then

        # backup: your own public key is a recipient unless --no-self

        if (( ! noSelf )); then
            local selfPublicKey="${identityFile%.${valtPrivateKeySuffix}}.${valtPublicKeySuffix}"
            [[ -f ${selfPublicKey} ]] || usage "public key not found: ${ tildePath "${selfPublicKey}"; } (or use --no-self)"
            recipients+=('-R' "${selfPublicKey}")
        fi
        (( ${#recipients[@]} )) || usage "--no-self requires at least one --recipient or --recipients-file"
        assertCompatibleRecipients "${recipients[@]}" # before logging in and exporting the vault
        [[ -n ${namePrefix} ]] || namePrefix="${USER}"
        declare -gr backupName="${namePrefix}-backup"
    else

        # restore

        declare -gr backupName="${ basename ${restoreFile} | cut -d'.' -f1-3; }"
    fi

    checkProjectDependencies 'wardn'

    addExitHandler cleanup
}

prepareVault() {
    clearTerminal
    echo
    if [[ -n ${restoreFile} ]]; then
        header -u "Restore Vault Backup"
    else
        header -u "Create Vault Backup"
    fi
    if ! useParentSession; then
        ensureLatestCLI
        unlockVault
    fi
    syncVault
}

useParentSession() {
    if [[ ${WARDN_USE_PARENT_SESSION} && ${BW_SESSION} ]]; then
        if [[ ${ sessionStatus; } == unlocked ]]; then
            echo "Skipping login, parent session appears valid${doneCheck}"
            return 0
        fi
    fi
    return 1
}

ensureLatestCLI() {
    local bwPath spinnerId
    bwPath=${ binaryPath bw "bitwarden client 'bw' not found!"; }

    startSpinner spinnerId "Checking Bitwarden CLI version"

    local soakDays=14 daysAgo
    if (( inNix )); then
        local installedVersion
        installedVersion=${ bw --version; }
        if _bwReleaseDaysAgo "${installedVersion}" daysAgo && (( daysAgo < soakDays )); then
            stopSpinner spinnerId ": ${ show yellow "${bwPath}" "at ${installedVersion} (Nix, ${daysAgo}d old)"; }"
            echo
            show "Bitwarden CLI ${installedVersion} was released ${daysAgo} day(s) ago."
            show "Soak period (${soakDays} days) has not elapsed — consider waiting before using this build."
            echo
        else
            stopSpinner spinnerId ": ${ show blue "${bwPath}" ;} at ${installedVersion} (Nix)${doneCheck}"
        fi
    elif command -v brew &> /dev/null; then
        if HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade --dry-run bitwarden-cli 2>&1 | grep -q "already installed"; then
            stopSpinner spinnerId ": ${ show blue "${bwPath}" ;} is up to date (via brew) at ${ bw --version; }${doneCheck}"
        else
            local latestVersion
            latestVersion=${ brew info --json bitwarden-cli 2> /dev/null | jq -r '.[0].versions.stable'; }
            if [[ -n ${latestVersion} && ${latestVersion} != 'null' ]] && _bwReleaseDaysAgo "${latestVersion}" daysAgo && (( daysAgo < soakDays )); then
                stopSpinner spinnerId ": ${ show yellow "${bwPath}" "update available (${daysAgo}d old, ${soakDays}d soak)"; }"
                echo
                show "Bitwarden CLI ${latestVersion} was released ${daysAgo} day(s) ago."
                show "Skipping upgrade: soak period (${soakDays} days) has not elapsed — supply chain protection."
                show "To upgrade now:" blue "HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade bitwarden-cli"
                echo
            else
                stopSpinner spinnerId ": ${ show bold red "${bwPath}" "is out of date." ;}"
                echo
                echo "Try executing: HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade bitwarden-cli"
                bye
            fi
        fi
    else
        stopSpinner spinnerId ": ${ show blue "${bwPath}" ;} at ${ bw --version; }${doneCheck}"
    fi
}

# Return 0 and set daysRef to the number of days since the given bitwarden-cli version was
# published on GitHub. Returns 1 if the release date cannot be determined.
_bwReleaseDaysAgo() {
    local version="$1"
    local -n daysRef=$2
    local json releasedAt releaseEpoch nowEpoch

    json=${ curl -sf --max-time 10 \
        -H 'Accept: application/vnd.github.v3+json' \
        "https://api.github.com/repos/bitwarden/clients/releases/tags/cli-v${version}"; } || return 1

    releasedAt=${ printf '%s' "${json}" | jq -r '.published_at'; }
    [[ -n ${releasedAt} && ${releasedAt} != 'null' ]] || return 1

    if (( onMacOS )); then
        releaseEpoch=${ date -juf '%Y-%m-%dT%H:%M:%SZ' "${releasedAt}" '+%s'; } || return 1
    else
        releaseEpoch=${ date -d "${releasedAt}" '+%s'; } || return 1
    fi
    nowEpoch=${ date -u '+%s'; }
    daysRef=$(( (nowEpoch - releaseEpoch) / 86400 ))
}

sessionStatus() {
    bw status | jq -r '.status'
}

unlockVault() {
    local spinnerId
    startSpinner spinnerId "Unlocking vault"

    logoutFromVault force # just in case there is an active session
    declare -gx BW_SESSION

    bw config server "${vaultUrl}" &> /dev/null

    if [[ -n ${BW_CLIENTID} ]]; then

        # Use api key to login
        debug "login with api key"
        bw login --apikey > /dev/null || fail "login with api key failed"

        # Unlock vault

        openVault unlock

    else

        # Login and unlock without api key

        debug "login with credentials"
        openVault login
    fi
    [[ -n ${BW_SESSION} ]] || fail "unlock failed"
}

openVault() {
    local command=$1
    declare -g BW_SESSION=
    if [[ -n ${WARDN_DEV_BW_PWD} ]]; then
        useDevPassword ${command}
    else
        useCredentials ${command}
    fi
}

useDevPassword() {
    local command=$1
    debug "useDevPassword ${command}"
    [[ ${command} == login ]] && stopSpinner spinnerId ". Credentials required..."
    BW_SESSION="${ assertCommand --error "Failed to ${command} vault" bw ${command} --raw --passwordenv WARDN_DEV_BW_PWD; }"
    [[ ${command} == unlock ]] && stopSpinner spinnerId "${doneCheck}"
}

useCredentials() {
    local command=$1
    stopSpinner spinnerId ". Credentials required..."
    debug "useCredentials ${command}"
    for retryIndex in {1..3}; do
        BW_SESSION="${ bw ${command} --raw; }" && break
    done
}

syncVault() {
    local spinnerId
    startSpinner spinnerId "Syncing vault"
    bw sync > /dev/null || fail
    stopSpinner spinnerId "${doneCheck}"
}

_stripBracketLines() {
    echo "$1" | grep -v '^\[.*\]$' | gsed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}'
}

# Create the secure work dir (secureWorkDir, with vaultFile and attachmentsDir) of at least sizeMb, for the
# unencrypted vault data. Unless the user agrees, stop if it cannot be RAM backed.

prepareSecureWorkDir() {
    local sizeMb=$1
    local tempDir isRamBacked
    makeSecureTempDir tempDir isRamBacked "${sizeMb}"
    if (( ! isRamBacked )); then
        require 'rayvn/prompt'
        local choice
        warn "Could not create RAM backed storage for the unencrypted vault data."
        show "   It will be stored on disk and deleted on exit, but deleted files may still be recoverable." nl
        confirm "Do you want to continue?" no yes choice || bye
        (( choice == 0 )) && bye
    fi
    cd "${tempDir}" || fail
    declare -gr secureWorkDir="${ makeDir "${tempDir}" "${backupName}"; }"
    declare -gr vaultFile="${secureWorkDir}/${vaultFileName}"
    declare -gr attachmentsDir="${ makeDir "${secureWorkDir}" "${attachmentsDirName}"; }"
}

backupVault() {
    local items item
    local attachmentItemIds attachmentItemId
    local attachments attachment attachmentId fileName length retryIndex
    local attachDir
    local itemsCount
    local attachmentsCount
    local spinnerId

    # Size the secure work dir for the export (about the size of the item list) and attachments, with room to spare

    items="${ bw list items; }"
    local attachmentBytes; attachmentBytes="${ echo "${items}" | jq '[.[] | .attachments[]? | .size | tonumber] | add // 0'; }"
    prepareSecureWorkDir $(( ( ${#items} * 2 + attachmentBytes ) / 1048576 * 2 + 64 ))

    startSpinner spinnerId "Backing up vault"
    bw export --raw --format json > "${vaultFile}" || fail
    itemsCount="${ echo "${items}" | jq 'length'; }"

    attachmentItemIds="${ echo ${items} | jq -r ".[] | select(.attachments).id"; }"

    for attachmentItemId in ${attachmentItemIds}; do
        item="${ echo "${items}" | jq -r ".[] | select(.id == \"${attachmentItemId}\")"; }"
        attachments="${ echo "${item}" | jq -r ".attachments"; }"
        length="${ echo "${attachments}" | jq -r ". | length"; }"

        for (( retryIndex = 0; retryIndex < ${length}; retryIndex++ )); do
            attachDir="${ makeDir ${attachmentsDir} ${attachmentItemId}; }"

            attachment="${ echo "${attachments}" | jq ".[${retryIndex}]"; }"
            attachmentId="${ echo "${attachment}" | jq -r ".id"; }"
            fileName="${ echo "${attachment}" | jq -r ".fileName"; }"

            # get attachment

            bw get attachment "${attachmentId}" --itemid "${attachmentItemId}" \
                --output "${attachDir}/${fileName}" > /dev/null 2>&1 || fail

            (( attachmentsCount++ ))
        done
    done

    stopSpinner spinnerId "${doneCheck}" # before creating the archive, which prompts for the key passphrase

    debug "creating secure archive, recipients=${recipients[*]}"
    local backupFile
    backupFile="${ newVaultBackup -i "${identityFile}" "${recipients[@]}" -n "${backupName}" -z "${timeZone}" -o "${backupDir}" "${secureWorkDir}"; }" || fail
    local size; size=${ du -h "${backupFile}" | cut -d' ' -f2 | cut -d $'\t' -f1; }

    if (( attachmentsCount > 0 )); then
        echo "Backed up ${itemsCount} items and ${attachmentsCount} attachments. ${successCheckMark}"
    else
        echo "Backed up ${itemsCount} items. ${successCheckMark}"
    fi
    logoutFromVault
    echo
    show bold green "Vault backed up to" "${ tildePath "${backupFile}"; }" bold green "size:" bold "${size}"
    show "Public companion (safe to share):" "${ tildePath "${backupFile}.pub"; }"
}

restoreVault() {

    # There are two issues with restoring a vault that make this implementation far more complicated
    # than expected/desirable:
    #
    #  1. Importing a vault REPLACES the item ids and creation/revision dates with NEW ones, therefore
    #  2. Restoring attachments requires MAPPING the old ids (from the backup) to the NEW ones.
    #
    # A reasonable case can be made that issue #1 is a bug. If fixed, BOTH issues go away.
    #
    # Since we MUST restore attachments, and we SHOULD use the original dates, we workaround these issues
    # using this high level approach:
    #
    #    import the backup -> export the result -> edit each item -> upload attachments
    #
    # Restore Procedure
    #
    #  0. ensure target vault is EMPTY
    #  1. unlock/unpack backup to temp dir
    #  2. load vault.json into ${oldVault}
    #  3. extract stats from ${oldVault}
    #  4. for each item in ${oldVault}, modify name with its index number. Used to map item ids independent of export order.
    #  5. create an oldIds array by extraction from ${oldVault}
    #  6. import ${oldVault} to target.
    #  7. export target vault to ${newVault}
    #  8. for each item in ${oldVault}, set oldId from oldIds(${i}) and:
    #       a. set oldId from ${oldIds} using loop index
    #       a. extract newItem from ${newVault} using loop index
    #       b. extract newId from ${newItem}
    #       c. update ${idMap} with ${oldId} -> ${newId} for attachment processing
    #       b. edit item ${newId} and update it with:
    #           1. name stripped of index prefix
    #           2. creation date from old item
    #           3. revision date from old item
    #           4. deleted date from old item
    #  9. create note item in target with stats
    # 10. restore attachments using ${idMap}
    #
    # NOTE: At present, an edit with any of the original dates fails; an issue has been created
    # (https://github.com/bitwarden/clients/issues/13429) and the code is commented until a fix is implemented.

    local backupFile="${restoreFile}"
    local backupFileName; backupFileName=${ basename ${backupFile}; }
    local oldIds=()
    declare -A idMap=()

    assertVaultReady  # (STEP 0)

    # Extract contents of decrypted backup file to secureWorkDir (STEP 1). The vault data compresses well, and is
    # imported and exported again, so allow for several times the backup's size.

    local backupMb; backupMb="${ du -sm "${backupFile}" | gawk '{print $1}'; }"
    prepareSecureWorkDir $(( backupMb * 20 + 64 ))

    echo "Preparing backup. You will be prompted for your private key passphrase if encrypted."
    cd "${secureWorkDir}" || fail
    extractVaultBackup -i "${identityFile}" -o "${secureWorkDir}" "${backupFile}" || fail

    local spinnerId
    startSpinner spinnerId "Preparing import" # don't start until here, since the above will likely prompt for a password

    # Get vault and grab some stats from it (STEPS 2 & 3)

    local oldVault; readFile "${vaultFileName}" oldVault
    local itemsCount; itemsCount="${ echo "${oldVault}" | jq '.items // 0 | length'; }"
    local foldersCount; foldersCount="${ echo "${oldVault}" | jq '.folders // 0 | length'; }"
    local attachmentsCount; attachmentsCount="${ find attachments -type f | wc -l | gawk '{print $1}'; }"

    # Update the names with sequence number prefixes so we can correctly map them later (STEP 4)

    debugJson oldVault 'before'
    prefixNamesWithIndex oldVault ${itemsCount}
    debugJson oldVault 'after'

    # Extract old item ids (STEP 5)

    mapfile -t oldIds < <(echo "${oldVault}" | jq -r '.items[].id')

    # Import updated vault (STEP 6)

    nextSpinner spinnerId "${doneCheck}" "Importing vault"
    echo "${oldVault}" > "${importVaultFileName}"
    bw import bitwardenjson "./${importVaultFileName}" > /dev/null || fail

    # Export vault (STEP 7)

    local newVault; newVault="${ bw export --format json --raw; }" || fail

    # Edit each item in the new vault to fix name and copy old dates, building idMap (STEP 8)

    local suffix; suffix="${ (( itemsCount < 10 )) && echo '' || echo ' (this may take some time)'; }"

    nextSpinner spinnerId "${doneCheck}" "Restoring ${itemsCount} items${suffix}"
    restoreItems oldVault newVault oldIds idMap ${itemsCount}

    # Add a note (STEP 9)

    addNote "${backupFile}" ${itemsCount} ${foldersCount} ${attachmentsCount}

    # Process attachments if we have any (STEP 10)

    if (( ${attachmentsCount} > 0 )); then
        nextSpinner spinnerId "${doneCheck}" "Uploading ${attachmentsCount} attachments"
        uploadAttachments idMap
    fi

    stopSpinner spinnerId "${doneCheck}"

    logoutFromVault

    echo
    show bold green "Restore completed."
    echo
    echo "A note named '${restoreNoteName}' was added to your vault with details of this operation."
    echo
    suffix="${ (( attachmentsCount > 0 )) && echo ' and attachments.' || echo '.'; }"
    echo "You will likely need to logout/login to see all restored items${suffix}"
}

nextSpinner() {
    local idVarName=$1 replacement="$2" message="$3"
    stopSpinner ${idVarName} "${replacement}"
    startSpinner ${idVarName} "${message}"
}

prefixNamesWithIndex() {   # STEP 4
    local -n vaultRef=$1
    local itemsCount=$2
    local i key name newName
    local tempVault="${vaultRef}" # TODO don't need this indirection

    for (( i = 0; i < itemsCount; i++ )); do
        name="${ echo "${tempVault}" | jq -r --argjson i ${i} '.items[$i].name'; }"
        newName="<${i}> ${name}"
        tempVault="${ echo "${tempVault}" | jq --argjson i ${i} --arg name "${newName}" '.items[$i].name=$name'; }"
    done
    vaultRef="${tempVault}"
}

restoreItems() { # STEP 8

    local -n oldVaultRef=$1
    local -n newVaultRef=$2
    local -n oldIdsRef=$3
    local -n idMapRef=$4
    local itemsCount=$5
    local i oldId oldItem newId newItem indexedName name key restoredItem editedItem # cDate rDate dDate

    for (( i = 0; i < itemsCount; i++ )); do

        # Get the oldId and oldItem

        oldId=${oldIdsRef[${i}]}
        oldItem="${ echo ${oldVaultRef} | jq -r --arg id "${oldId}" '.items[] | select(.id == $id)'; }"

        # Lookup the newItem by index and extract newId

        newItem="${ echo "${newVaultRef}" | jq -r --arg index ${i} '.items[] | select(.name | startswith("<" + ($index|tostring) + ">"))'; }"
        newId="${ echo "${newItem}" | jq -r '.id'; }"

        # Update the idMap for attachment processing

        idMapRef["${oldId}"]="${newId}"

        # Get the item name without the index prefix

        indexedName="${ echo ${newItem} | jq -r '.name'; }"
        name="${indexedName#\<[0-9]*\> }"

        debug ''; debugVars i oldId newId indexedName name

        # Update newItem

# TODO See https://github.com/bitwarden/clients/issues/13429
#
#        cDate=$(echo ${oldItem} | jq -r '.creationDate')
#        rDate=$(echo ${oldItem} | jq -r '.revisionDate')
#        dDate=$(echo ${oldItem} | jq -r '.deletedDate')
#
#        restoredItem=$(echo "${newItem}" | jq -c --arg name "${name}" --arg id "${newId}" --arg c "${cDate}" --arg r "${rDate}" --arg d "${dDate}" \
#            '.name=$name | .id=$id | .creationDate=$c | .revisionDate=$r | .deletedDate=$d' )

        restoredItem="${ echo "${newItem}" | jq -c --arg name "${name}"  --arg id "${newId}" '.name=$name | .id=$id'; }"
        debugJson restoredItem "restoredItem-${i}"

        # Finally, edit the item in the vault to restore it

        editedItem="${ echo "${restoredItem}" | bw encode | bw edit item "${newId}"; }"
        debugJson editedItem "editedItem-${i}"

    done
}

addNote() {  # STEP 9
    local source="${1}"
    local items=$2
    local folders=$3
    local attachments=$4
    local i; i=${ [[ ${items} == 1 ]] && echo item || echo items; }
    local f; f=${ [[ ${folders} == 1 ]] && echo folder || echo folders; }
    local a; a=${ [[ ${items} == 1 ]] && echo attachment || echo attachments; }
    local format='Restored on %s\n\n%d %s, %d %s, %d %s from %s\n'
    local note; note="${ printf "${format}" "${ date; }" ${items} ${i} ${folders} ${f} ${attachments} ${a} "${source}"; }"

    # TODO Add hostname, username, uname, IP, reverse dns... https://iplocation.io/ ip.info ???

    debugJson note

    local temp; temp=${ bw get template item; } || fail
    local name="${restoreNoteName}"
    local item; item=${ echo ${temp} | jq -r --arg nm "${name}" --arg nt "${note}" '.type=2 | .secureNote.type=0 | .name=$nm | .notes=$nt'; }
    echo ${item} | bw encode | bw create item > /dev/null || fail
}

uploadAttachments() { # STEP 10
    local -n idMapRef=$1
    local attachmentDir attachmentFile
    pushd "${attachmentsDirName}" > /dev/null || fail

    for attachmentDir in ./*; do

        pushd "${attachmentDir}" > /dev/null || fail
        local oldAttachmentItemId; oldAttachmentItemId=${ basename ${attachmentDir}; }
        local newAttachmentItemId="${idMapRef[${oldAttachmentItemId}]}"
        debugVars oldAttachmentItemId newAttachmentItemId

        for attachmentFile in ./*; do
            debugVars attachmentFile
            bw create attachment --file "./${attachmentFile}" --itemid "${newAttachmentItemId}" > /dev/null || fail
        done
        popd > /dev/null || fail
    done
}

assertVaultReady() {
    local spinnerId
    startSpinner spinnerId "Checking vault"

    local vault; vault=${ bw export --raw --format json; }

    local orgVault; orgVault=${ echo "${vault}" | jq '.collections != null' | grep true; }
    [[ -n ${orgVault} ]] && fail "Cannot restore to an Organization vault (yet)."

    local itemsCount; itemsCount=${ echo "${vault}" | jq '.items // 0 | length'; }
    (( itemsCount == 0 )) || failVaultNotEmpty

    local foldersCount; foldersCount=${ echo "${vault}" | jq '.folders // 0 | length'; }
    (( foldersCount == 0 )) || failVaultNotEmpty
    stopSpinner spinnerId "${doneCheck}"
}

failVaultNotEmpty() {
    stopSpinner spinnerId ": ${ show red "vault must be empty before restoring to it." ;}"
    echo
    show "If you are" bold italic "not sure" "that you have a current backup, make another one or restore"
    echo "to a new account (with a Premium subscription if you have attachments)."
    echo
    echo "If you choose to empty the target vault:"
    echo
    show "  1. In a browser, login at" blue "${vaultUrl}" "."
    show "  2. In the left pane, under" bold "Settings" ", click" bold "My Account" "."
    show "  3. In the" red "Danger zone" "section, click" red "Purge vault" "."
    show "  4. In the popup, enter you master password and click" red "Purge vault" "."
    echo
    bye
}

logoutFromVault() {
    local arg=$1
    if [[ ${arg} == force ]]; then
        bw logout > /dev/null 2>&1
        unset BW_SESSION
    elif [[ ${BW_SESSION} && ! ${WARDN_USE_PARENT_SESSION} ]]; then
        bw logout > /dev/null 2>&1
        unset BW_SESSION
    fi
}

cleanup() {
    logoutFromVault # the secure work dir is removed by rayvn on exit
}

updateCLI () { # TODO: harden and expose command!
    local url
    local installFile; installFile=${ command -v bw; }
    local installDir; installDir=${ dirname ${installFile}; }
    echo "Installed version: ${ ${installFile} --version; }"
    if [[ -z ${url} ]]; then
        local response; response=${ bw update | grep http; }
        if [[ -n ${response} ]]; then
            url="http${response##*http}"
        fi
    fi
    if [[ "${url}" ]]; then
        local tempFile="${installFile}.zip"
        curl "${url}" -L -o "${tempFile}" 2> /dev/null || return
        rm "${installFile}" 2>&1 > /dev/null
        unzip -q -u "${tempFile}" -d "${installDir}"
        rm "${tempFile}" || return
        chmod +x "${installFile}" || return
        echo "       Updated to: ${ ${installFile} --version; }"
    else
        echo "No update available."
    fi
}

# Boot rayvn with initial required libraries

source rayvn.up 'rayvn/spinner' 'rayvn/terminal' 'rayvn/dependencies' 'valt/keys' 'wardn/backup' || exit

main "${@}"
